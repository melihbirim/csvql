#compdef csvql
#
# zsh completion for csvql
#
# Install: copy this file to a directory on $fpath, named `_csvql`, e.g.
#   cp _csvql ~/.zsh/completions/_csvql      # with fpath+=(~/.zsh/completions) before compinit
#
# Keep the flag list in sync with `csvql --help`; tests/completions_test.zig
# fails when a documented flag is missing here.

# `csvql install` takes only --print.
if (( CURRENT > 2 )) && [[ $words[2] == install ]]; then
    compadd -- --print
    return
fi

_arguments -S \
    '(- *)'{-h,--help}'[show help]' \
    '(- *)'{-v,--version}'[show version]' \
    '--no-header[suppress header row in output]' \
    '--no-input-header[treat the first row as data, name columns c1..cN]' \
    '(-o --output)'{-o,--output}'[write results to a file instead of stdout]:output file:_files' \
    '(-d --delimiter)'{-d,--delimiter}'[field delimiter]:delimiter: ' \
    '(--jsonl --table --no-table --markdown)--json[output a JSON array of objects]' \
    '(--json --table --no-table --markdown)--jsonl[output newline-delimited JSON]' \
    '(--json --jsonl --no-table --markdown)--table[always render output as a table]' \
    '(--json --jsonl --table --markdown)--no-table[never render output as a table]' \
    '(--json --jsonl --table --no-table)--markdown[render output as a Markdown table]' \
    '--wrap[wrap long cell text across lines]' \
    '--threads[worker threads for parallel execution (0 = auto)]:threads: ' \
    '--strict[error on non-numeric values in WHERE numeric comparisons]' \
    '--schema[show column names, inferred types, row count, file size]:csv file:_files' \
    '--mcp[start as an MCP server]' \
    '--root[confine file access to these directories]:directories:_files -/' \
    '--audit[append a JSONL record per query]:audit file:_files' \
    '1:file or subcommand: _alternative "subcommands:subcommand:(install)" "files:file:_files"' \
    '*:file or query:_files'
