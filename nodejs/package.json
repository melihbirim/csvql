{
  "name": "csvql-query",
  "version": "1.5.5",
  "description": "Fast SQL queries on CSV files — Zig/SIMD engine via N-API",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "zig build node -Doptimize=ReleaseFast && cp ../zig-out/lib/csvql.node .",
    "test": "node test.js",
    "bench": "node bench.js"
  },
  "keywords": [
    "csv",
    "sql",
    "query",
    "simd",
    "fast",
    "etl",
    "parser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melihbirim/csvql"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "csvql-query-darwin-arm64": "1.5.5",
    "csvql-query-darwin-x64": "1.5.5",
    "csvql-query-linux-x64": "1.5.5",
    "csvql-query-linux-arm64": "1.5.5",
    "csvql-query-win32-x64": "1.5.5"
  },
  "devDependencies": {
    "csv-parse": "^7.0.0",
    "papaparse": "^5.5.4"
  }
}
