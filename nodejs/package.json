{
  "name": "csvql-query",
  "version": "1.7.2",
  "description": "Fast SQL queries on CSV files — Zig/SIMD engine via N-API",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binaries/"
  ],
  "scripts": {
    "build": "zig build node -Doptimize=ReleaseFast && mkdir -p binaries && cp ../zig-out/lib/csvql.node binaries/$(node -p \"process.platform + '-' + process.arch\").node",
    "test": "node test.js",
    "bench": "node bench.js"
  },
  "keywords": [
    "csv",
    "sql",
    "query",
    "simd",
    "fast",
    "etl",
    "parser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melihbirim/csvql.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "csv-parse": "^7.0.0",
    "papaparse": "^5.5.4"
  }
}
