{
  "name": "csvql-query",
  "version": "2.6.2",
  "description": "SQL on CSV files in place — no import, no database. Zig/SIMD engine for Node and AI agents (MCP). Read-only by design.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "csvql-query": "cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "binaries/"
  ],
  "scripts": {
    "build": "zig build node -Doptimize=ReleaseFast && mkdir -p binaries && cp ../zig-out/lib/csvql.node binaries/$(node -p \"process.platform + '-' + process.arch\").node",
    "test": "node test.js",
    "test:cli": "node test_cli.js",
    "bench": "node bench.js"
  },
  "keywords": [
    "csv",
    "sql",
    "query",
    "simd",
    "fast",
    "etl",
    "parser",
    "agent",
    "ai",
    "mcp",
    "llm",
    "cli",
    "duckdb",
    "analytics",
    "dataframe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melihbirim/csvql.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "csv-parse": "^7.0.0",
    "papaparse": "^5.5.4"
  }
}
